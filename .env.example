# ─────────────────────────────────────────────
#  Cho's 매니지먼트 봇 — 환경변수 템플릿
#  이 파일을 복사해서 .env 로 저장 후 값 입력
#  .env 는 절대 Git에 올리지 마세요
# ─────────────────────────────────────────────

# ── Discord ──────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_server_id_here          # 개발용 서버 ID
CHO_USER_ID=your_discord_user_id_here         # Cho 본인 Discord ID

# ── Notion ───────────────────────────────────
NOTION_TOKEN=your_notion_integration_token
NOTION_STREAMERS_DB=notion_database_id_for_streamers
NOTION_BROADCAST_LOG_DB=notion_database_id_for_broadcast_logs
NOTION_REPORT_DB=notion_database_id_for_reports
NOTION_SCHEDULE_DB=notion_database_id_for_schedule

# ── Google / Gemini ──────────────────────────
GEMINI_API_KEY=your_gemini_api_key
YOUTUBE_CLIENT_ID=your_youtube_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_oauth_client_secret
YOUTUBE_API_KEY=your_youtube_data_api_key     # 공개 데이터용

# ── OpenAI ───────────────────────────────────
OPENAI_API_KEY=your_openai_api_key

# ── Anthropic ────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Perplexity ───────────────────────────────
PERPLEXITY_API_KEY=your_perplexity_api_key

# ── 설정 ─────────────────────────────────────
ENVIRONMENT=development                        # development | production
LOG_LEVEL=INFO
WEEKLY_REPORT_DAY=0                            # 0=월요일, 6=일요일
WEEKLY_REPORT_HOUR=9                           # 오전 9시
BATCH_INTERVAL_MINUTES=10                      # 채팅 배치 분석 주기
VIEWER_POLL_INTERVAL_SECONDS=300               # 시청자 수 polling 주기 (5분)

# ── OpenRouter ───────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...

# ── 포럼채널 ──────────────────────────────────
FORUM_CHANNEL_ID=1234567890123456789